{
  "name": "escrutinia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --exclude lib/queries/snapshots.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
